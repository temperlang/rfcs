+
+/** Folds a value into an accumulated one, as `reduce` takes. */
+export @fun interface Accumulator<A, T>(accumulated: A, value: T): A;
+
+/** Takes a value for its effect, as `forEach` takes. */
+export @fun interface Consumer<T>(value: T): Void;
+
+/** Gives a value when asked, such as a message computed only if needed. */
+export @fun interface Supplier<T>(): T;
+
+/** Maps a map's entry, as `toListWith` takes. */
